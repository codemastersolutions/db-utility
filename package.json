{
  "name": "@codemastersolutions/db-utility",
  "version": "0.0.32",
  "description": "Database utility for migrations, seeders, factories, introspection and more...",
  "files": [
    "dist",
    "README.md",
    "README.pt-BR.md",
    "README.es.md",
    "LICENSE",
    "LICENSE.pt-BR",
    "LICENSE.es"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "db-utility": "./dist/cli/index.js",
    "dbutility": "./dist/cli/index.js",
    "dbutil": "./dist/cli/index.js"
  },
  "scripts": {
    "prebuild": "rimraf dist && pnpm lint && pnpm format && pnpm test",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration:mssql": "cross-env DBUTILITY_RUN_DOCKER_INTEGRATION=1 vitest run tests/integration/testing/SequelizeMssqlLongString.test.ts tests/integration/testing/SequelizeMssqlDateDefault.test.ts tests/integration/testing/SequelizeMssqlCompositeForeignKey.test.ts tests/integration/testing/SequelizeMssqlSelfCompositeForeignKey.test.ts tests/integration/testing/SequelizeMssqlCompositeForeignKeySetNull.test.ts tests/integration/testing/TypeormMssqlLongString.test.ts tests/integration/testing/TypeormMssqlDateDefault.test.ts",
    "test:integration:mssql:sequelize": "cross-env DBUTILITY_RUN_DOCKER_INTEGRATION=1 vitest run tests/integration/testing/SequelizeMssqlLongString.test.ts tests/integration/testing/SequelizeMssqlDateDefault.test.ts tests/integration/testing/SequelizeMssqlCompositeForeignKey.test.ts tests/integration/testing/SequelizeMssqlSelfCompositeForeignKey.test.ts tests/integration/testing/SequelizeMssqlCompositeForeignKeySetNull.test.ts",
    "test:integration:mssql:typeorm": "cross-env DBUTILITY_RUN_DOCKER_INTEGRATION=1 vitest run tests/integration/testing/TypeormMssqlLongString.test.ts tests/integration/testing/TypeormMssqlDateDefault.test.ts",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "pnpm run build",
    "commitzero": "commitzero",
    "commitzero:install": "pnpm exec commitzero install-hooks",
    "commitzero:uninstall": "pnpm exec commitzero uninstall-hooks",
    "commit": "pnpm exec commitzero commit --add",
    "commit:push": "pnpm exec commitzero commit --add --push"
  },
  "keywords": [
    "database",
    "utility",
    "mssql",
    "mysql",
    "postgres",
    "introspection",
    "migration",
    "sequelize",
    "typeorm",
    "prisma"
  ],
  "author": "CodeMaster Soluções",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codemastersolutions/db-utility.git"
  },
  "bugs": {
    "url": "https://github.com/codemastersolutions/db-utility/issues"
  },
  "homepage": "https://github.com/codemastersolutions/db-utility#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "dependencies": {
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "inquirer": "^14.0.2",
    "mssql": "^12.2.0",
    "mysql2": "^3.16.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@codemastersolutions/commitzero": "^0.0.55",
    "@eslint/js": "^9.39.4",
    "@types/mssql": "^9.1.8",
    "@types/node": "^25.0.8",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^4.0.17",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.3",
    "sequelize": "^6.37.8",
    "tedious": "^19.2.1",
    "ts-node": "^10.9.2",
    "typeorm": "^1.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  }
}
