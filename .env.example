# Configuração do Banco de Dados
# Tipos suportados: postgres, mysql, mssql

DBUTILITY_DB_TYPE=postgres
DBUTILITY_DB_HOST=localhost
DBUTILITY_DB_PORT=5432
DBUTILITY_DB_USER=postgres
DBUTILITY_DB_PASSWORD=postgres
DBUTILITY_DB_NAME=dbutility_test
DBUTILITY_DB_CONNECT_TIMEOUT_MS=15000

# Ou use connection string
# DBUTILITY_DB_CONNECTION_STRING=postgres://user:pass@host:5432/db

# Criptografia dos dados de conexão
# Chave de criptografia para os campos host, port, username, password e database
# Gera valores criptografados com: db-utility encrypt "valor"
# DBUTILITY_ENCRYPTION_KEY="sua-chave-secreta-aqui"
# Quando os valores acima estiverem criptografados, defina como true:
# DBUTILITY_DB_ENCRYPTED=true

# Migrações
# Desabilita a verificação padrão de existência da tabela antes do createTable (true/false)
# DB_UTILITY_MIGRATIONS_DISABLE_TABLE_EXISTS_CHECK=true
